# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/smartkit"

# Auth
BETTER_AUTH_SECRET="this-is-a-secret-key-for-development-only-32chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional -- set NEXT_PUBLIC_GOOGLE_ENABLED="true" to show button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Resend (optional -- sign-up still works, email will just be skipped)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SePay (Vietnamese VietQR Payment - optional)
# Register at https://my.sepay.vn
# Bank codes: VCB (Vietcombank), TCB (Techcombank), MB (MB Bank), ACB, etc.
SEPAY_API_KEY="Bearer your-api-key-here"
SEPAY_WEBHOOK_SECRET="your-webhook-secret-here"
SEPAY_BANK_ACCOUNT="1234567890"
SEPAY_BANK_NAME="VCB"

# Vercel Cron auth (set in Vercel project env; local dev can use any string)
# CRON_SECRET="generate-with-openssl-rand-hex-32"

# Node
NODE_ENV="development"
